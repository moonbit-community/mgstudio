pub impl Default for SlabAllocatorSettings

pub struct SlabGrowth {
  kind : SlabGrowthKind
  old_slot_capacity : Int
  current_slot_capacity : Int
} derive(Eq, @debug.Debug)
pub fn SlabGrowth::current_slot_capacity(Self) -> Int
pub fn SlabGrowth::kind(Self) -> SlabGrowthKind
pub fn SlabGrowth::old_slot_capacity(Self) -> Int

pub(all) enum SlabGrowthKind {
  NoGrowthNeeded
  NeededGrowth
  CantGrow
} derive(Eq, @debug.Debug)

