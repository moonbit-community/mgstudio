pub struct VertexState {
  shader : String?
  shader_defs : Array[ShaderDefVal]
  entry_point : String?
  buffers : Array[@mesh.VertexBufferLayout]
}
pub fn VertexState::VertexState() -> Self
pub fn VertexState::buffers(Self) -> Array[@mesh.VertexBufferLayout]
pub fn VertexState::entry_point(Self) -> String?
