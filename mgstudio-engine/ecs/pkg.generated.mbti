pub impl[A : QueryData, B : QueryData, C : QueryData, D : QueryData, E : QueryData] QueryData for (A, B, C, D, E)
pub impl[A : QueryData, B : QueryData, C : QueryData, D : QueryData, E : QueryData, F : QueryData] QueryData for (A, B, C, D, E, F)
pub impl[A : QueryData, B : QueryData, C : QueryData, D : QueryData, E : QueryData, F : QueryData, G : QueryData] QueryData for (A, B, C, D, E, F, G)
pub impl[A : QueryData, B : QueryData, C : QueryData, D : QueryData, E : QueryData, F : QueryData, G : QueryData, H : QueryData] QueryData for (A, B, C, D, E, F, G, H)

pub(open) trait QueryFilter {
  fn matches(Self, World, @core.Entity) -> Bool
  fn matches_table_row(Self, World, @core.Entity, Int, Int) -> Bool = _
  fn mentions_component(Self, Int) -> Bool
  fn matches_component_set(Self, (Int) -> Bool) -> Bool
  fn collect_access(Self, QueryFilterAccess) -> Unit = _
  fn requires_entity_check(Self) -> Bool
  fn requires_entity_check_for_world(Self, World) -> Bool = _
  fn is_dense(Self, World) -> Bool = _
  fn iteration_anchor_component(Self) -> Int?
  fn iteration_anchor_components(Self) -> Array[Int] = _
  fn depends_on_ticks(Self) -> Bool
}
pub impl[A : QueryFilter, B : QueryFilter] QueryFilter for (A, B)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter] QueryFilter for (A, B, C)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter, D : QueryFilter] QueryFilter for (A, B, C, D)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter, D : QueryFilter, E : QueryFilter] QueryFilter for (A, B, C, D, E)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter, D : QueryFilter, E : QueryFilter, F : QueryFilter] QueryFilter for (A, B, C, D, E, F)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter, D : QueryFilter, E : QueryFilter, F : QueryFilter, G : QueryFilter] QueryFilter for (A, B, C, D, E, F, G)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter, D : QueryFilter, E : QueryFilter, F : QueryFilter, G : QueryFilter, H : QueryFilter] QueryFilter for (A, B, C, D, E, F, G, H)

pub(open) trait QueryFilterDisjunction {
  fn matches_any(Self, World, @core.Entity) -> Bool
  fn matches_table_row_any(Self, World, @core.Entity, Int, Int) -> Bool = _
  fn mentions_component_any(Self, Int) -> Bool
  fn matches_component_set_any(Self, (Int) -> Bool) -> Bool
  fn collect_access_any(Self, QueryFilterAccess) -> Unit = _
  fn requires_entity_check_any(Self) -> Bool
  fn requires_entity_check_any_for_world(Self, World) -> Bool = _
  fn is_dense_any(Self, World) -> Bool = _
  fn depends_on_ticks_any(Self) -> Bool
}
pub impl[A : QueryFilter, B : QueryFilter] QueryFilterDisjunction for (A, B)
pub impl[A : QueryFilter, B : QueryFilter, C : QueryFilter] QueryFilterDisjunction for (A, B, C)

pub(open) trait ResourceData {
}

pub(open) trait TriggerEvent {
  fn observer_event() -> EventKey[Self]
  fn observer_entity(Self) -> @core.Entity?
  fn set_observer_entity(Self, @core.Entity) -> Self
  fn auto_propagate(Self) -> Bool
  fn debug_name() -> String
}

