import {
  "Milky2018/mgstudio/ecs",
  "Milky2018/mgstudio/post_process",
  "moonbitlang/core/json",
  "Milky2018/mgstudio/shader/source" @shader_source,
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name bloom_wgsl_source",
      "input": "bloom.wgsl",
      "output": "bloom_wgsl.mbt",
    },
  ],
)
