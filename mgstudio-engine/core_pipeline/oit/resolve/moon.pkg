import {
  "Milky2018/mgstudio/app",
  "Milky2018/mgstudio/ecs",
  "Milky2018/mgstudio/asset",
  "Milky2018/mgstudio/shader/source" @shader_source,
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name oit_resolve_wgsl_source",
      "input": "oit_resolve.wgsl",
      "output": "oit_resolve_wgsl.mbt",
    },
  ],
)
