import {
  "Milky2018/mgstudio/app",
  "Milky2018/mgstudio/ecs",
  "Milky2018/mgstudio/core_pipeline/oit/resolve",
  "moonbitlang/core/json",
  "Milky2018/mgstudio/asset",
  "Milky2018/mgstudio/shader/source" @shader_source,
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name oit_draw_wgsl_source",
      "input": "oit_draw.wgsl",
      "output": "oit_draw_wgsl.mbt",
    },
  ],
)
