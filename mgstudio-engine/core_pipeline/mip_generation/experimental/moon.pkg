import {
  "Milky2018/mgstudio/app",
  "Milky2018/mgstudio/ecs",
  "Milky2018/mgstudio/asset",
  "Milky2018/mgstudio/shader/source" @shader_source,
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name downsample_depth_wgsl_source",
      "input": "downsample_depth.wgsl",
      "output": "downsample_depth_wgsl.mbt",
    },
  ],
)
