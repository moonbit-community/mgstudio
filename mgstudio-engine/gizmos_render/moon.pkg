import {
  "Milky2018/mgstudio/camera/camera" @camera_camera,
  "Milky2018/mgstudio/hierarchy",
  "Milky2018/mgstudio/mesh/primitives/dim3" @mesh_primitives_dim3,
  "Milky2018/mgstudio/visibility",
  "Milky2018/mgstudio/camera/visibility/render_layers" @camera_render_layers,
  "Milky2018/mgstudio/app",
  "Milky2018/mgstudio/asset",
  "Milky2018/mgstudio/color",
  "Milky2018/mgstudio/core",
  "Milky2018/mgstudio/ecs",
  "Milky2018/mgstudio/gizmos",
  "Milky2018/mgstudio/material",
  "Milky2018/mgstudio/math",
  "Milky2018/mgstudio/mesh",
  "Milky2018/mgstudio/pbr",
  "Milky2018/mgstudio/render",
  "Milky2018/mgstudio/shader/source" @shader_source,
  "Milky2018/mgstudio/sprite_render",
  "Milky2018/mgstudio/transform",
  "Milky2018/wgpu_mbt" @wgpu,
}

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name line_gizmo_lines_wgsl_source",
      "input": "lines.wgsl",
      "output": "lines_wgsl.mbt",
    },
    {
      "command": ":embed --input $input --output $output --name line_gizmo_joints_wgsl_source",
      "input": "line_joints.wgsl",
      "output": "line_joints_wgsl.mbt",
    },
  ],
)
