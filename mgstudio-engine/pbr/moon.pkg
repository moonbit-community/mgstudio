import {
  "Milky2018/mgstudio/color",
  "Milky2018/mgstudio/camera/camera" @camera_camera,
  "Milky2018/mgstudio/camera/components3d" @camera_components3d,
  "Milky2018/mgstudio/camera/render_target" @camera_render_target,
  "Milky2018/mgstudio/camera/visibility/render_layers" @camera_render_layers,
  "moonbitlang/core/float",
  "moonbitlang/core/hashmap",
  "moonbitlang/core/hashset",
  "moonbitlang/core/json",
  "moonbitlang/core/encoding/utf8",
  "moonbitlang/x/sys",
  "Milky2018/mgstudio/app",
  "Milky2018/mgstudio/animation",
  "Milky2018/mgstudio/anti_alias/contrast_adaptive_sharpening" @cas,
  "Milky2018/mgstudio/asset",
  "Milky2018/mgstudio/camera/primitives" @camera_primitives,
  "Milky2018/mgstudio/camera/projection3d" @camera_projection3d,
  "Milky2018/mgstudio/camera/viewport" @camera_viewport,
  "Milky2018/mgstudio/core_pipeline",
  "Milky2018/mgstudio/core_pipeline/core_3d",
  "Milky2018/mgstudio/core",
  "Milky2018/mgstudio/ecs",
  "Milky2018/mgstudio/gltf/loader" @gltf_loader,
  "Milky2018/mgstudio/input",
  "Milky2018/mgstudio/light",
  "Milky2018/mgstudio/light/cluster" @light_cluster,
  "Milky2018/mgstudio/math",
  "Milky2018/mgstudio/material",
  "Milky2018/mgstudio/mesh",
  "Milky2018/mgstudio/mesh/primitives/dim3" @mesh_primitives_dim3,
  "Milky2018/mgstudio/pbr/atmosphere" @pbr_atmosphere,
  "Milky2018/mgstudio/pbr/decal" @pbr_decal,
  "Milky2018/mgstudio/pbr/deferred" @pbr_deferred,
  "Milky2018/mgstudio/pbr/light_probe" @pbr_light_probe,
  "Milky2018/mgstudio/pbr/lightmap",
  "Milky2018/mgstudio/pbr/prepass" @pbr_prepass,
  "Milky2018/mgstudio/pbr/ssao" @pbr_ssao,
  "Milky2018/mgstudio/pbr/ssr" @pbr_ssr,
  "Milky2018/mgstudio/pbr/volumetric_fog" @pbr_volumetric_fog,
  "Milky2018/mgstudio/post_process",
  "Milky2018/mgstudio/post_process/motion_blur" @post_process_motion_blur,
  "Milky2018/mgstudio/render",
  "Milky2018/mgstudio/render/batching" @render_batching,
  "Milky2018/mgstudio/render/mesh" @render_mesh,
  "Milky2018/mgstudio/render/mesh_view_layout",
  "Milky2018/mgstudio/render/occlusion_culling" @render_occlusion_culling,
  "Milky2018/mgstudio/render/render_phase",
  "Milky2018/mgstudio/render/render_resource",
  "Milky2018/mgstudio/render/renderer",
  "Milky2018/mgstudio/render/texture" @render_texture,
  "Milky2018/mgstudio/render/view" @render_view,
  "Milky2018/mgstudio/render/view/visibility" @render_visibility,
  "Milky2018/mgstudio/shader",
  "Milky2018/mgstudio/shader/source" @shader_source,
  "Milky2018/mgstudio/pbr/render" @pbr_render,
  "Milky2018/mgstudio/pbr/transmission",
  "Milky2018/mgstudio/sprite",
  "Milky2018/mgstudio/transform",
  "Milky2018/mgstudio/time",
  "Milky2018/mgstudio/ui_render",
  "Milky2018/mgstudio/visibility",
  "Milky2018/mgstudio/window",
  "Milky2018/mgstudio/shader/runtime_render" @shader_runtime_render,
  "Milky2018/wgpu_mbt" @wgpu,
}

import {
  "Milky2018/mgstudio/camera/visibility" @camera_visibility,
  "Milky2018/mgstudio/core_pipeline/fullscreen_vertex_shader/source" @fullscreen_vertex_shader_source,
  "Milky2018/mgstudio/mesh/primitives" @mesh_primitives,
  "Milky2018/mgstudio/shader/compile" @shader_compile,
  "Milky2018/wgsl/common" @wgsl_common,
} for "test"

import {
  "Milky2018/mgstudio/mesh/primitives" @mesh_primitives,
} for "wbtest"

supported_targets = "native"

options(
  "pre-build": [
    {
      "command": ":embed --input $input --output $output --name pbr_cluster_wgsl_source",
      "input": "cluster/cluster.wgsl",
      "output": "gpu_clustering_cluster_wgsl.mbt",
    },
    {
      "command": ":embed --input $input --output $output --name pbr_cluster_allocate_wgsl_source",
      "input": "cluster/cluster_allocate.wgsl",
      "output": "gpu_clustering_cluster_allocate_wgsl.mbt",
    },
    {
      "command": ":embed --input $input --output $output --name pbr_cluster_raster_wgsl_source",
      "input": "cluster/cluster_raster.wgsl",
      "output": "gpu_clustering_cluster_raster_wgsl.mbt",
    },
    {
      "command": ":embed --input $input --output $output --name pbr_cluster_z_slice_wgsl_source",
      "input": "cluster/cluster_z_slice.wgsl",
      "output": "gpu_clustering_cluster_z_slice_wgsl.mbt",
    },
    {
      "command": ":embed --input $input --output $output --name pbr_dummy_meshlet_visibility_buffer_resolve_wgsl_source",
      "input": "meshlet/dummy_visibility_buffer_resolve.wgsl",
      "output": "dummy_meshlet_visibility_buffer_resolve_wgsl.mbt",
    },
  ],
)
