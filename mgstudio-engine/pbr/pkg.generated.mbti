// Traits
pub(open) trait AutoExposureCompensationCurveSource {
  fn to_auto_exposure_curve(Self) -> @math.CubicCurve[@math.Vec2] raise @math.InsufficientDataError
}
pub impl AutoExposureCompensationCurveSource for @math.CubicCurve[@math.Vec2]
pub impl AutoExposureCompensationCurveSource for @math.LinearSpline[@math.Vec2]

pub(open) trait CameraProjection3d {
  fn get_clip_from_view(Self) -> @Milky2018/mgstudio/pbr/render.ProjectionMatrix3d
  fn get_clip_from_view_for_sub(Self, @Milky2018/mgstudio/pbr/render.SubCameraView3d) -> @Milky2018/mgstudio/pbr/render.ProjectionMatrix3d
  fn update(Self, Float, Float) -> Self
  fn far(Self) -> Float
  fn compute_frustum(Self, @transform.Transform) -> @Milky2018/mgstudio/pbr/render.Frustum
  fn get_frustum_corners(Self, Float, Float) -> Array[@math.Vec3]
}
pub impl CameraProjection3d for @Milky2018/mgstudio/pbr/render.OrthographicProjection3d
pub impl CameraProjection3d for @Milky2018/mgstudio/pbr/render.PerspectiveProjection3d

pub(open) trait IntoPbrMaterialAsset {
  fn into_pbr_material_asset(Self) -> @material.StandardMaterial
}
pub impl IntoPbrMaterialAsset for @asset.Handle[@image.Image]
pub impl IntoPbrMaterialAsset for @color.Color
pub impl IntoPbrMaterialAsset for @material.StandardMaterial

pub(open) trait IntoPbrMeshAsset {
  fn into_pbr_mesh_asset(Self) -> @Milky2018/mgstudio/mesh.Mesh
}
pub impl IntoPbrMeshAsset for @math.Capsule3d
pub impl IntoPbrMeshAsset for @math.Cone
pub impl IntoPbrMeshAsset for @math.ConicalFrustum
pub impl IntoPbrMeshAsset for @math.Cuboid
pub impl IntoPbrMeshAsset for @math.Cylinder
pub impl IntoPbrMeshAsset for @math.Plane3d
pub impl IntoPbrMeshAsset for @math.Polyline3d
pub impl IntoPbrMeshAsset for @math.Segment3d
pub impl IntoPbrMeshAsset for @math.Sphere
pub impl IntoPbrMeshAsset for @math.Tetrahedron
pub impl IntoPbrMeshAsset for @math.Torus
pub impl IntoPbrMeshAsset for @math.Triangle3d
pub impl IntoPbrMeshAsset for @Milky2018/mgstudio/mesh.Mesh3dGeometry

pub(open) trait MaterialExtension {
  fn extension_tag(Self) -> Int
  fn vertex_shader(Self) -> String?
  fn fragment_shader(Self) -> String?
  fn prepass_vertex_shader(Self) -> String?
  fn prepass_fragment_shader(Self) -> String?
  fn deferred_vertex_shader(Self) -> String?
  fn deferred_fragment_shader(Self) -> String?
  fn alpha_mode(Self) -> @material.AlphaMode3d?
  fn opaque_render_method(Self) -> @material.OpaqueRendererMethod?
  fn enable_prepass(Self) -> Bool
  fn enable_shadows(Self) -> Bool
}

