import {
  "Milky2018/mgstudio/app",
  "Milky2018/mgstudio/embedded_asset",
  "Milky2018/mgstudio/image",
  "Milky2018/mgstudio/math",
  "Milky2018/zstd",
  "moonbitlang/core/debug",
  "moonbitlang/core/json",
  "moonbitlang/core/hashmap",
  "moonbitlang/core/string",
  "moonbitlang/core/ref",
  "moonbitlang/core/encoding/utf8",
  "Milky2018/mgstudio/ecs",
  "gmlewis/image" @gm_image,
  "gmlewis/image/color" @gm_color,
  "gmlewis/image/jpeg" @gm_jpeg,
  "gmlewis/image/png" @gm_png,
  "gmlewis/flate",
  "gmlewis/gzip" @gm_gzip,
  "gmlewis/io" @gm_io,
  "moonbitlang/x/fs",
  "moonbitlang/x/path",
  "moonbitlang/x/sys",
}

supported_targets = "native"

options(
  link: { "native": { "cc-link-flags": "-lcurl" } },
  "native-stub": [ "web_asset_stub.c" ],
)
